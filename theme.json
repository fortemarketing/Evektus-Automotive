{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "720px", "wideSize": "1440px" },
    "typography": {
      "fontFamilies": [
        {
          "name": "Median",
          "slug": "median",
          "fontFamily": "\"Median\", \"Arial Black\", \"Helvetica Neue\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Median",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/median/Median-Regular.woff2",
                "file:./assets/fonts/median/Median-Regular.woff"
              ]
            }
          ]
        },
        {
          "name": "Inter",
          "slug": "inter",
          "fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
        }
      ]
    }
  }
}
